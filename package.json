{
  "name": "rent",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "deploy": "netlify deploy --prod --build",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "check": "npm run typecheck && npm run lint && npm test && npm run build && npm run check:bundle && npm run check:rpc",
    "check:bundle": "node scripts/check-bundle.mjs",
    "check:rpc": "node scripts/check-rpc-contracts.mjs",
    "check:remote-schema": "node scripts/check-remote-schema.mjs",
    "preview": "vite preview",
    "db:login": "supabase login",
    "db:link": "supabase link --project-ref geeyefhmccqbtvlfesba",
    "db:pull": "supabase link --project-ref geeyefhmccqbtvlfesba && supabase db pull",
    "db:migrations": "supabase migration list",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --linked > src/database.types.ts",
    "db:push": "supabase link --project-ref geeyefhmccqbtvlfesba && supabase db push"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.98.0",
    "@tailwindcss/vite": "^4.2.1",
    "@tanstack/react-query": "^5.96.2",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.575.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hot-toast": "^2.6.0",
    "react-router-dom": "^7.18.1",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@playwright/test": "^1.62.0",
    "@types/node": "^26.1.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/parser": "^8.65.0",
    "@vitejs/plugin-react": "^6.0.4",
    "eslint": "^9.13.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "globals": "^15.11.0",
    "netlify-cli": "^23.15.1",
    "supabase": "^2.109.1",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.9.3",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
